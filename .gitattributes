# Final-release line-ending + binary hygiene. Web sources normalize to LF so
# Windows checkouts (CRLF) can never smuggle carriage returns into the app;
# binaries are never mangled by conversion. Safe on all platforms.
* text=auto
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp3 binary
*.wav binary
*.ogg binary
*.zip binary
*.dmg binary
*.exe binary
*.msi binary
*.sh text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.rs text eol=lf
*.toml text eol=lf
